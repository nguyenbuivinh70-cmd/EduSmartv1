rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
    }

    function memberData(schoolId) {
      return get(memberPath(schoolId)).data;
    }

    function isActiveMember(schoolId) {
      return signedIn() && activeProfile(schoolId, memberData(schoolId));
    }

    function activeProfile(schoolId, profile) {
      return profile != null && profile.get('schoolId', schoolId) == schoolId
        && profile.get('status', profile.get('trang_thai', '')) == 'active';
    }

    function sameGradeValue(left, right) {
      return left == right
        || (left == 6 && right in ['6', '6.0']) || (right == 6 && left in ['6', '6.0'])
        || (left == 7 && right in ['7', '7.0']) || (right == 7 && left in ['7', '7.0'])
        || (left == 8 && right in ['8', '8.0']) || (right == 8 && left in ['8', '8.0'])
        || (left == 9 && right in ['9', '9.0']) || (right == 9 && left in ['9', '9.0'])
        || (left == '6' && right == '6.0') || (left == '6.0' && right == '6')
        || (left == '7' && right == '7.0') || (left == '7.0' && right == '7')
        || (left == '8' && right == '8.0') || (left == '8.0' && right == '8')
        || (left == '9' && right == '9.0') || (left == '9.0' && right == '9');
    }

    function memberGradeValue(schoolId) {
      let profile = memberData(schoolId);
      let canonical = profile.get('grade', '');
      return canonical == null || canonical == '' ? profile.get('khoi', '') : canonical;
    }

    function memberClassValue(schoolId) {
      let profile = memberData(schoolId);
      let canonical = profile.get('classId', '');
      return canonical == null || canonical == '' ? profile.get('lop_id', '') : canonical;
    }

    function lessonContentReadableStatus(data) {

      return !data.keys().hasAny(['content_status']) || data.content_status != 'preparing';
    }

    function adminProfile(profile) {
      return profile.get('role', profile.get('vai_tro', '')) == 'admin' || profile.get('adminPermission', profile.get('quyen_admin', false)) in [true, 'true', 'TRUE', 'True', 1, '1'];
    }

    function teacherGradeProfile(profile, grade) {
      let scopes = profile.get('gradeScopes', profile.get('khoi_phu_trach', []));
      return profile.get('role', profile.get('vai_tro', '')) == 'teacher'
        && (adminProfile(profile) || profile.get('allGrades', profile.get('tat_ca_khoi', false)) in [true, 'true', 'TRUE', 'True', 1, '1']
          || (scopes is list && scopes.size() > 0
            ? (scopes.hasAny([grade])
              || (grade == '6' && scopes.hasAny([6])) || (grade == 6 && scopes.hasAny(['6']))
              || (grade == '7' && scopes.hasAny([7])) || (grade == 7 && scopes.hasAny(['7']))
              || (grade == '8' && scopes.hasAny([8])) || (grade == 8 && scopes.hasAny(['8']))
              || (grade == '9' && scopes.hasAny([9])) || (grade == 9 && scopes.hasAny(['9'])))
            : sameGradeValue(profile.get('grade', profile.get('khoi', '')), grade)));
    }

    function isAdmin(schoolId) {
      let profile = memberData(schoolId);
      return signedIn() && activeProfile(schoolId, profile) && adminProfile(profile);
    }

    function isTeacher(schoolId) {
      let profile = memberData(schoolId);
      return signedIn() && activeProfile(schoolId, profile) && profile.get('role', profile.get('vai_tro', '')) == 'teacher';
    }

    function canManageLearningContent(schoolId) {
      let profile = memberData(schoolId);
      return signedIn() && activeProfile(schoolId, profile)
        && (adminProfile(profile) || profile.get('role', profile.get('vai_tro', '')) == 'teacher');
    }

    function teacherManagesGrade(schoolId, grade) {

      let profile = memberData(schoolId);
      return signedIn() && activeProfile(schoolId, profile) && teacherGradeProfile(profile, grade);
    }

    function canManageGradeData(schoolId, data) {
      let profile = memberData(schoolId);
      return signedIn() && activeProfile(schoolId, profile)
        && (adminProfile(profile) || (data.get('khoi', '') is string
          && data.get('khoi', '') != '' && teacherGradeProfile(profile, data.khoi)));
    }

    function hasAudienceMetadata(data) {
      return (data.keys().hasAll(['lop_id']) && data.lop_id != '')
        || (data.keys().hasAll(['khoi']) && data.khoi != '');
    }

    function matchesAudience(schoolId, data) {

      return (hasAudienceMetadata(data)
          && (!data.keys().hasAll(['lop_id'])
            || data.lop_id == ''
            || (memberClassValue(schoolId) != ''
              && data.lop_id == memberClassValue(schoolId)))
          && (!data.keys().hasAll(['khoi'])
            || data.khoi == ''
            || (memberGradeValue(schoolId) != ''
              && sameGradeValue(data.khoi, memberGradeValue(schoolId)))))
        || (!hasAudienceMetadata(data)
          && (!data.keys().hasAll(['audienceKeys'])
            || (data.audienceKeys is list
              && (data.audienceKeys.hasAny(['all'])
                || (memberGradeValue(schoolId) != ''
                  && (((memberGradeValue(schoolId) is string)
                      && data.audienceKeys.hasAny(['grade:' + memberGradeValue(schoolId)]))
                    || (sameGradeValue(memberGradeValue(schoolId), 6) && data.audienceKeys.hasAny(['grade:6']))
                    || (sameGradeValue(memberGradeValue(schoolId), 7) && data.audienceKeys.hasAny(['grade:7']))
                    || (sameGradeValue(memberGradeValue(schoolId), 8) && data.audienceKeys.hasAny(['grade:8']))
                    || (sameGradeValue(memberGradeValue(schoolId), 9) && data.audienceKeys.hasAny(['grade:9']))))
                || (memberClassValue(schoolId) is string
                  && memberClassValue(schoolId) != ''
                  && data.audienceKeys.hasAny(['class:' + memberClassValue(schoolId)]))))));
    }

    function canReadPublishedAudience(schoolId, data) {
      return data.keys().hasAll(['pham_vi', 'trang_thai'])
        && data.pham_vi == 'shared'
        && data.trang_thai == 'approved_shared'
        && matchesAudience(schoolId, data);
    }

    function canReadPublishedReview(schoolId, data) {
      return data.keys().hasAll(['pham_vi', 'trang_thai'])
        && data.pham_vi == 'shared'
        && data.trang_thai == 'active'
        && matchesAudience(schoolId, data);
    }


    function reviewTargetsCurrentClass(schoolId, data) {
      let targets = data.get('target_class_ids', []);
      let classId = memberClassValue(schoolId);
      return !(targets is list) || targets.size() == 0
        || (classId is string && classId != '' && targets.hasAny([classId]));
    }

    function reviewClassIsUnlocked(schoolId, data) {
      let locked = data.get('locked_class_ids', []);
      let classId = memberClassValue(schoolId);
      return !(locked is list) || locked.size() == 0
        || classId == '' || !locked.hasAny([classId]);
    }

    function reviewScheduleIsOpen(data) {
      let start = data.get('available_from_at', null);
      let end = data.get('available_until_at', null);
      return (!(start is timestamp) || request.time >= start)
        && (!(end is timestamp) || request.time <= end);
    }

    function canOpenPublishedReview(schoolId, data) {
      return canReadPublishedReview(schoolId, data)
        && reviewTargetsCurrentClass(schoolId, data)
        && reviewClassIsUnlocked(schoolId, data)
        && reviewScheduleIsOpen(data);
    }

    function canCreateReviewAttempt(schoolId) {
      let data = request.resource.data;
      let reviewId = data.get('review_id', '');
      let reviewPath = /databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId);
      let review = get(reviewPath).data;
      let mode = data.get('study_mode', 'single');
      let participants = data.get('participant_user_ids', []);
      let currentUserId = currentStudentUserId(schoolId);
      return isActiveMember(schoolId)
        && reviewId is string && reviewId != '' && exists(reviewPath)
        && data.schoolId == schoolId
        && data.ownerUid == request.auth.uid
        && data.user_id == currentUserId
        && reviewTargetsCurrentClass(schoolId, review)
        && (mode == 'co_learning' ? review.get('allow_co_learning', true) == true : review.get('allow_solo', true) == true)
        && (mode != 'co_learning' || (participants is list && participants.hasAny([currentUserId])));
    }

    function canReadLessonData(schoolId, data) {
      return isActiveMember(schoolId)
        && (isAdmin(schoolId)
          || (data.keys().hasAll(['createdByUid'])
            && data.createdByUid == request.auth.uid
            && (!isTeacher(schoolId) || canManageGradeData(schoolId, data)))
          || (canManageLearningContent(schoolId)
            && canManageGradeData(schoolId, data)
            && data.keys().hasAll(['pham_vi'])
            && data.pham_vi == 'shared')
          || canReadPublishedAudience(schoolId, data));
    }

    function isLessonLocked(data) {
      return data.keys().hasAll(['is_locked']) && data.is_locked == true;
    }

    function lessonAllowsAfterEnd(data) {
      return data.keys().hasAny(['cho_phep_hoc_sau_han'])
        && data.cho_phep_hoc_sau_han in [true, 'true', 1, '1'];
    }

    function isLessonScheduleOpen(data) {

      let startText = data.get('thoi_gian_bat_dau', '');
      let endText = data.get('thoi_gian_ket_thuc', '');
      let start = data.get('access_start_at', null);
      let end = data.get('access_end_at', null);
      let hasStart = startText is string && startText != '';
      let hasEnd = endText is string && endText != '';
      return (!hasStart || start == null || !(start is timestamp) || request.time >= start)
        && (lessonAllowsAfterEnd(data) || !hasEnd || end == null || !(end is timestamp) || request.time <= end);
    }

    function studentOfficialRetakeAccess(schoolId, lessonId) {
      let profile = memberData(schoolId);
      let userId = profile.get('userId', profile.get('user_id', ''));
      let progressId = userId + '_' + lessonId;
      return isActiveMember(schoolId)
        && profile.get('role', profile.get('vai_tro', 'student')) == 'student'
        && userId is string && userId != ''
        && exists(/databases/$(database)/documents/schools/$(schoolId)/learningProgress/$(progressId))
        && get(/databases/$(database)/documents/schools/$(schoolId)/learningProgress/$(progressId)).data.get('official_retake_remaining', 0) > 0
        && get(/databases/$(database)/documents/schools/$(schoolId)/learningProgress/$(progressId)).data.get('official_retake_grant_id', '') != '';
    }

    function canReadLessonContent(schoolId, data) {
      return canReadLessonData(schoolId, data)
        && (lessonContentReadableStatus(data) || canManageLearningContent(schoolId))
        && (memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) != 'student'
          || studentOfficialRetakeAccess(schoolId, data.get('lesson_id', ''))
          || (!isLessonLocked(data) && isLessonScheduleOpen(data)));
    }

    function teachingSessionPath(schoolId, lessonId, classId) {
      return /databases/$(database)/documents/schools/$(schoolId)/teachingSessions/$(lessonId + '__' + classId);
    }

    function preLessonEnabledForMember(schoolId, lessonData) {
      return canReadLessonData(schoolId, lessonData)
        && lessonData.get('pre_lesson_enabled', true) != false
        && ((lessonData.get('intro_video_url', '') is string && lessonData.get('intro_video_url', '') != '')
          || (lessonData.get('intro_video_embed_url', '') is string && lessonData.get('intro_video_embed_url', '') != ''))
        && (!isLessonLocked(lessonData) || lessonData.get('pre_lesson_allow_when_locked', true) != false);
    }

    function currentStudentUserId(schoolId) {
      return memberData(schoolId).get('userId', memberData(schoolId).get('user_id', ''));
    }

    function isCurrentStudentCanonicalPreLessonId(schoolId, progressId) {
      let userId = currentStudentUserId(schoolId);
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && userId != ''
        && progressId.matches(userId + '_.*');
    }

    function preLessonProgressBelongsToCurrentStudent(schoolId, data) {
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && (data.get('ownerUid', '') == request.auth.uid
          || data.get('user_id', '') == currentStudentUserId(schoolId));
    }

    function validPreLessonLegacyMigration(schoolId, progressId) {
      let oldData = resource.data;
      let newData = request.resource.data;
      let currentUserId = currentStudentUserId(schoolId);
      return currentUserId != ''
        && progressId == currentUserId + '_' + newData.lesson_id
        && newData.user_id == currentUserId
        && newData.ownerUid == request.auth.uid
        && oldData.get('user_id', '') in ['', currentUserId]
        // V6.85.2: canonical path + current member userId là bằng chứng sở hữu.
        // Cho phép sửa ownerUid legacy bị trống/sai nhưng không cho đổi user/lesson.
        && oldData.get('lesson_id', '') in ['', newData.lesson_id]
        && newData.watched_seconds >= oldData.get('watched_seconds', 0)
        && newData.watch_percent >= oldData.get('watch_percent', 0)
        && newData.get('playback_seconds', 0) >= oldData.get('playback_seconds', 0);
    }

    function validPreLessonProgressWrite(schoolId, progressId) {
      let data = request.resource.data;
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data;
      let threshold = lesson.get('pre_lesson_completion_threshold', 80);
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && data.schoolId == schoolId && data.schemaVersion == 4
        && data.ownerUid == request.auth.uid
        && data.user_id == memberData(schoolId).get('userId', memberData(schoolId).get('user_id', ''))
        && progressId == data.user_id + '_' + data.lesson_id
        && sameGradeValue(data.khoi, memberGradeValue(schoolId))
        && data.get('lop_id', '') == memberClassValue(schoolId)
        && data.video_status in ['not_started', 'in_progress', 'completed']
        && data.duration_seconds is number && data.duration_seconds >= 0
        && data.watched_seconds is number && data.watched_seconds >= 0
        && data.watch_percent is number && data.watch_percent >= 0 && data.watch_percent <= 100
        && data.get('playback_seconds', 0) is number && data.get('playback_seconds', 0) >= 0
        && data.get('last_position_seconds', 0) is number && data.get('last_position_seconds', 0) >= 0
        && data.get('watched_ranges', []) is list && data.get('watched_ranges', []).size() <= 1200
        && data.get('coverage_model', '') == 'unique_seconds_v1'
        && data.get('preparation_status', '') in ['not_started', 'in_progress', 'prepared', 'late_completed']
        && threshold is number && threshold >= 50 && threshold <= 100
        && ((data.video_status == 'completed' && data.watch_percent >= threshold
              && data.preparation_status in ['prepared', 'late_completed'])
          || (data.video_status != 'completed' && data.watch_percent < threshold
              && data.preparation_status in ['not_started', 'in_progress']))
        && preLessonEnabledForMember(schoolId, lesson);
    }

    function preLessonCompletionBeforeDeadlineAllowed(schoolId, data) {
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data;
      let deadline = lesson.get('pre_lesson_deadline_at', null);
      return data.completed_before_deadline == false
        || !(deadline is timestamp)
        || request.time <= deadline;
    }

    function validPreLessonCompletionCreate(schoolId) {
      let data = request.resource.data;
      return data.completed_before_deadline is bool
        && data.updatedAt == request.time
        && ((data.video_status != 'completed' && data.completed_before_deadline == false
              && data.preparation_status in ['not_started', 'in_progress'])
          || (data.video_status == 'completed'
            && ((data.completed_before_deadline == true && data.preparation_status == 'prepared')
              || (data.completed_before_deadline == false && data.preparation_status == 'late_completed'))
            && preLessonCompletionBeforeDeadlineAllowed(schoolId, data)));
    }

    function validPreLessonCompletionUpdate(schoolId) {
      let data = request.resource.data;
      let oldCompleted = resource.data.get('video_status', '') == 'completed';
      let oldHasDeadlineState = resource.data.keys().hasAny(['completed_before_deadline']);
      let oldHasCompletedAt = resource.data.keys().hasAny(['completed_at']) && resource.data.get('completed_at', '') != '';
      return data.completed_before_deadline is bool
        && data.updatedAt == request.time
        && ((data.video_status != 'completed' && data.completed_before_deadline == false
              && data.preparation_status in ['not_started', 'in_progress'])
          || (data.video_status == 'completed'
            && ((data.completed_before_deadline == true && data.preparation_status == 'prepared')
              || (data.completed_before_deadline == false && data.preparation_status == 'late_completed'))
            && preLessonCompletionBeforeDeadlineAllowed(schoolId, data)))
        && (!oldCompleted
          || (data.video_status == 'completed'
            && (!oldHasDeadlineState || data.completed_before_deadline == resource.data.get('completed_before_deadline', false))
            && (!oldHasCompletedAt || data.completed_at == resource.data.get('completed_at', ''))));
    }


    // V6.87.1: submission chuẩn bị bài dùng security envelope tối giản, bền vững
    // với lesson/member legacy. Trước đây Rules buộc threshold/revision/deadline phải
    // có đúng kiểu dữ liệu mới, khiến các bài cũ (ví dụ "80" thay vì 80) bị
    // permission-denied dù học sinh đã xem đủ. Client vẫn chỉ mở nút Gửi khi đạt
    // ngưỡng; Rules tiếp tục bắt buộc ownership, audience, video hợp lệ, %/thời
    // lượng hợp lệ và server timestamp. Deadline được phân loại ở ứng dụng dựa trên
    // submittedAt; không dùng sai khác kiểu legacy làm lý do từ chối ghi.
    function configuredPreLessonThreshold(lesson) {
      let value = lesson.get('pre_lesson_completion_threshold', 80);
      return value in [50, '50'] ? 50
        : value in [55, '55'] ? 55
        : value in [60, '60'] ? 60
        : value in [65, '65'] ? 65
        : value in [70, '70'] ? 70
        : value in [75, '75'] ? 75
        : value in [80, '80', '80.0'] ? 80
        : value in [85, '85'] ? 85
        : value in [90, '90', '90.0'] ? 90
        : value in [95, '95'] ? 95
        : value in [100, '100', '100.0'] ? 100
        : 80;
    }

    function validPreLessonSubmissionWrite(schoolId, submissionId) {
      let data = request.resource.data;
      let currentUserId = currentStudentUserId(schoolId);
      let lessonPath = /databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.get('lesson_id', ''));
      let lessonExists = data.get('lesson_id', '') is string && data.get('lesson_id', '') != '' && exists(lessonPath);
      let lesson = lessonExists ? get(lessonPath).data : null;
      let threshold = lessonExists ? configuredPreLessonThreshold(lesson) : 80;
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && currentUserId is string && currentUserId != ''
        && lessonExists
        && submissionId == currentUserId + '_' + data.get('lesson_id', '')
        && data.get('schoolId', '') == schoolId
        && data.get('schemaVersion', 0) in [1, 2]
        && data.get('ownerUid', '') == request.auth.uid
        && data.get('user_id', '') == currentUserId
        && data.get('video_revision', 0) is int && data.get('video_revision', 0) >= 1
        && data.get('required_percent', 0) is number
        && data.get('required_percent', 0) >= threshold
        && data.get('required_percent', 0) <= 100
        && data.get('duration_seconds', 0) is number && data.get('duration_seconds', 0) > 0
        && data.get('watched_seconds', 0) is number && data.get('watched_seconds', 0) >= 0
        && data.get('watched_seconds', 0) <= data.get('duration_seconds', 0) + 3
        && data.get('watch_percent', 0) is number
        && data.get('watch_percent', 0) >= threshold && data.get('watch_percent', 0) <= 100
        && data.get('watched_seconds', 0) * 100 >= data.get('duration_seconds', 0) * threshold
        && data.get('preparation_status', '') in ['prepared', 'late_completed']
        && data.get('completed_before_deadline', false) is bool
        && data.get('submittedAt', null) == request.time
        && preLessonEnabledForMember(schoolId, lesson);
    }

    function validPreLessonSubmissionUpdate(schoolId, submissionId) {
      return validPreLessonSubmissionWrite(schoolId, submissionId)
        && request.resource.data.get('user_id', '') == resource.data.get('user_id', '')
        && request.resource.data.get('lesson_id', '') == resource.data.get('lesson_id', '')
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('video_revision', 0) > resource.data.get('video_revision', 0);
    }


    // V6.88.0: submission cuối cùng nằm dưới chính lesson để Rules không phải
    // tin vào metadata lớp/khối/deadline do client lặp lại. Rules chỉ kiểm tra
    // chủ sở hữu, bài cha, ngưỡng xem và server timestamp. Trạng thái đúng hạn/
    // muộn được suy ra khi đọc báo cáo từ submittedAt + deadline của lesson.
    function validPreparationSubmissionCreate(schoolId, lessonId, submissionId) {
      let data = request.resource.data;
      let lessonPath = /databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId);
      let lessonExists = exists(lessonPath);
      let lesson = lessonExists ? get(lessonPath).data : null;
      let threshold = lessonExists ? configuredPreLessonThreshold(lesson) : 80;
      let currentUserId = currentStudentUserId(schoolId);
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && lessonExists
        && currentUserId is string && currentUserId != ''
        && submissionId.matches(request.auth.uid + '_r[0-9]+')
        && data.get('schemaVersion', 0) == 3
        && data.get('lessonId', '') == lessonId
        && data.get('ownerUid', '') == request.auth.uid
        && data.get('user_id', '') == currentUserId
        && data.get('videoRevision', 0) is int && data.get('videoRevision', 0) >= 1
        && data.get('watchPercent', 0) is number
        && data.get('watchPercent', 0) >= threshold && data.get('watchPercent', 0) <= 100
        && data.get('watchedSeconds', 0) is number && data.get('watchedSeconds', 0) >= 0
        && data.get('durationSeconds', 0) is number && data.get('durationSeconds', 0) > 0
        && data.get('watchedSeconds', 0) <= data.get('durationSeconds', 0) + 5
        && data.get('submittedAt', null) == request.time
        && preLessonEnabledForMember(schoolId, lesson);
    }

    function lessonSelfStudyEnabled(schoolId, lessonData) {
      let scope = lessonData.get('self_study_scope', lessonData.get('access_mode', 'teacher_controlled') == 'self_study' ? 'all' : 'none');
      let classId = memberClassValue(schoolId);
      return scope == 'all'
        || (scope == 'classes'
          && classId is string && classId != ''
          && lessonData.get('self_study_class_ids', []) is list
          && lessonData.get('self_study_class_ids', []).hasAny([classId]));
    }

    function completedOfficialAccess(schoolId, lessonId) {
      let userId = currentStudentUserId(schoolId);
      let progressId = userId + '_' + lessonId;
      return userId is string && userId != ''
        && exists(/databases/$(database)/documents/schools/$(schoolId)/learningProgress/$(progressId))
        && (get(/databases/$(database)/documents/schools/$(schoolId)/learningProgress/$(progressId)).data.get('score_status', '') == 'finalized'
          || (get(/databases/$(database)/documents/schools/$(schoolId)/learningProgress/$(progressId)).data.get('status', '') == 'completed'
            && get(/databases/$(database)/documents/schools/$(schoolId)/learningProgress/$(progressId)).data.keys().hasAny(['assessment_score'])));
    }

    function studentActivityReleased(schoolId, lessonId, activityId, lessonData) {
      let classId = memberClassValue(schoolId);
      let role = memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student'));
      return isActiveMember(schoolId)
        && role == 'student'
        && canReadLessonContent(schoolId, lessonData)
        && (completedOfficialAccess(schoolId, lessonId)
          || (classId is string && classId != ''
            && exists(teachingSessionPath(schoolId, lessonId, classId))
            && get(teachingSessionPath(schoolId, lessonId, classId)).data.schoolId == schoolId
            && get(teachingSessionPath(schoolId, lessonId, classId)).data.lesson_id == lessonId
            && get(teachingSessionPath(schoolId, lessonId, classId)).data.class_id == classId
            && sameGradeValue(get(teachingSessionPath(schoolId, lessonId, classId)).data.grade, memberGradeValue(schoolId))
            && get(teachingSessionPath(schoolId, lessonId, classId)).data.status in ['live', 'ended']
            && get(teachingSessionPath(schoolId, lessonId, classId)).data.released_activity_ids is list
            && get(teachingSessionPath(schoolId, lessonId, classId)).data.released_activity_ids.hasAny([activityId])));
    }

    function validTeachingSessionWrite(schoolId, sessionId) {
      let data = request.resource.data;
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data;
      return isActiveMember(schoolId)
        && data.schoolId == schoolId && data.schemaVersion == 4
        && data.class_id is string && data.class_id != ''
        && sessionId == data.lesson_id + '__' + data.class_id
        && sameGradeValue(data.grade, lesson.khoi)
        && data.status in ['idle', 'live', 'ended']
        && data.released_activity_ids is list
        && (!data.keys().hasAny(['current_activity_id'])
          || data.current_activity_id == ''
          || (data.current_activity_id is string
            && data.released_activity_ids.hasAny([data.current_activity_id])))
        && (!data.keys().hasAny(['current_page_id']) || data.current_page_id is string)
        && data.updated_by_uid == request.auth.uid
        && (isAdmin(schoolId)
          || (isTeacher(schoolId)
            && canManageGradeData(schoolId, lesson)
            && ((lesson.get('createdByUid', '') == request.auth.uid)
              || (lesson.get('pham_vi', '') == 'shared' && lesson.get('trang_thai', '') == 'approved_shared'))));
    }

    function canWriteOwnedContent(schoolId, data) {
      return isAdmin(schoolId)
        || (isTeacher(schoolId) && data.createdByUid == request.auth.uid);
    }

    function canDeleteLessonDependency(schoolId, lessonId) {
      return isAdmin(schoolId)
        || (isTeacher(schoolId)
          && lessonId is string
          && lessonId.size() > 0
          && exists(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId))
          && get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data.createdByUid == request.auth.uid
          && canManageGradeData(
            schoolId,
            get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
          ));
    }

    function canReadTeacherOwnedOrShared(schoolId, data) {
      return isTeacher(schoolId)
        && canManageGradeData(schoolId, data)
        && ((data.keys().hasAll(['createdByUid']) && data.createdByUid == request.auth.uid)
          || (data.keys().hasAll(['pham_vi']) && data.pham_vi == 'shared'));
    }

    function canReadTeacherReview(schoolId, data) {
      return isTeacher(schoolId)
        && canManageGradeData(schoolId, data)
        && ((data.keys().hasAll(['ownerUid']) && data.ownerUid == request.auth.uid)
          || (data.keys().hasAll(['pham_vi']) && data.pham_vi == 'shared'));
    }

    function canManageReviewAttempt(schoolId, reviewId) {
      return isAdmin(schoolId)
        || (isTeacher(schoolId)
          && reviewId is string
          && reviewId.size() > 0
          && exists(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId))
          && canReadTeacherReview(
            schoolId,
            get(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId)).data
          ));
    }

    function validCatalogDocument(schoolId) {
      return request.resource.data.schoolId == schoolId
        && request.resource.data.schemaVersion == 1;
    }


    // V6.88.1: Gemini API key được lưu theo Firebase UID trong vùng bí mật riêng.
    // Không admin/giáo viên nào được đọc key của tài khoản khác; chỉ chính UID đó.
    function validUserAISecretWrite(schoolId, memberId) {
      return isActiveMember(schoolId)
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly([
          'schoolId', 'ownerUid', 'userId', 'schemaVersion',
          'api_key', 'api_key_masked', 'has_api_key', 'model_ai',
          'updated_at', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schoolId', 'ownerUid', 'userId', 'schemaVersion',
          'api_key', 'api_key_masked', 'has_api_key', 'model_ai',
          'updated_at', 'updatedAt'
        ])
        && request.resource.data.schoolId == schoolId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.userId == memberData(schoolId).get('userId', memberData(schoolId).get('user_id', ''))
        && request.resource.data.schemaVersion == 1
        && request.resource.data.api_key is string
        && request.resource.data.api_key.size() >= 20
        && request.resource.data.api_key.size() <= 512
        && request.resource.data.api_key_masked is string
        && request.resource.data.api_key_masked.size() <= 32
        && request.resource.data.has_api_key == true
        && request.resource.data.model_ai is string
        && request.resource.data.model_ai.size() > 0
        && request.resource.data.model_ai.size() <= 120
        && request.resource.data.updated_at is string
        && request.resource.data.updated_at.size() > 0
        && request.resource.data.updatedAt == request.time;
    }

    function validArenaLessonMetadata() {
      return (!request.resource.data.keys().hasAny(['arena_question_count'])
          || (request.resource.data.arena_question_count is number
            && request.resource.data.arena_question_count >= 0
            && request.resource.data.arena_question_count <= 5000))
        && (!request.resource.data.keys().hasAny(['arena_ready'])
          || request.resource.data.arena_ready is bool);
    }

    function validLessonAccessConfiguration() {
      return (!request.resource.data.keys().hasAny(['access_mode'])
          || request.resource.data.access_mode in ['teacher_controlled', 'self_study'])
        && (!request.resource.data.keys().hasAny(['self_study_scope'])
          || request.resource.data.self_study_scope in ['none', 'classes', 'all'])
        && (!request.resource.data.keys().hasAny(['self_study_class_ids'])
          || (request.resource.data.self_study_class_ids is list
            && request.resource.data.self_study_class_ids.size() <= 100))
        && (!(request.resource.data.get('self_study_scope', 'none') == 'classes')
          || (request.resource.data.get('self_study_class_ids', []) is list
            && request.resource.data.get('self_study_class_ids', []).size() > 0))
        && (!request.resource.data.keys().hasAny(['allow_retake_after_completion'])
          || request.resource.data.allow_retake_after_completion is bool);
    }

    function validLessonSecurityEnvelope(schoolId, lessonId) {

      return request.resource.data.keys().hasAll([
          'lesson_id', 'schoolId', 'schemaVersion', 'createdByUid', 'khoi'
        ])
        && request.resource.data.lesson_id == lessonId
        && request.resource.data.schoolId == schoolId
        && request.resource.data.schemaVersion == 2
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.khoi is string
        && request.resource.data.khoi.size() > 0
        && canManageGradeData(schoolId, request.resource.data);
    }

    function validLessonUpdateSecurityEnvelope(schoolId, lessonId) {
      return request.resource.data.keys().hasAll([
          'lesson_id', 'schoolId', 'schemaVersion', 'createdByUid', 'khoi'
        ])
        && request.resource.data.lesson_id == lessonId
        && request.resource.data.schoolId == schoolId
        && request.resource.data.schemaVersion == 2
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.khoi is string
        && request.resource.data.khoi.size() > 0
        && canManageGradeData(schoolId, request.resource.data);
    }

    function lessonIdentityFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'lesson_number', 'lesson_name', 'lesson_key', 'tieu_de',
        'mon_id', 'khoi', 'lop_id', 'nam_hoc', 'hoc_ky'
      ]);
    }

    function validMemberCreate(schoolId, memberId) {
      return request.resource.data.keys().hasAll([
          'authUid', 'userId', 'username', 'displayName', 'email',
          'role', 'status', 'adminPermission', 'schoolId'
        ])
        && request.resource.data.authUid == memberId
        && request.resource.data.schoolId == schoolId
        && request.resource.data.status in ['active', 'inactive', 'locked']
        && request.resource.data.role in ['admin', 'teacher', 'student']
        && (request.resource.data.role != 'teacher'
          || ((!request.resource.data.keys().hasAny(['gradeScopes'])
              || request.resource.data.gradeScopes is list)
            && (!request.resource.data.keys().hasAny(['allGrades'])
              || request.resource.data.allGrades is bool)));
    }

    function studentRosterPath(schoolId, studentCode) {
      return /databases/$(database)/documents/schools/$(schoolId)/studentRoster/$(studentCode);
    }

    function validStudentRosterDocument(schoolId, studentCode) {
      return request.resource.data.keys().hasAll([
          'userId', 'username', 'displayName', 'email', 'role', 'status',
          'adminPermission', 'schoolId', 'classId', 'grade', 'studentCode',
          'schemaVersion'
        ])
        && request.resource.data.schoolId == schoolId
        && request.resource.data.studentCode == studentCode
        && request.resource.data.username == studentCode
        && request.resource.data.email == studentCode + '@hthtv1.firebaseapp.com'
        && request.resource.data.role == 'student'
        && request.resource.data.adminPermission == false
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.schemaVersion == 1;
    }

    function validStudentRosterClaim(schoolId, memberId) {
      return signedIn()
        && request.auth.uid == memberId
        && request.resource.data.role == 'student'
        && request.resource.data.adminPermission == false
        && request.resource.data.authUid == memberId
        && request.resource.data.schoolId == schoolId
        && request.resource.data.status == 'active'
        && request.resource.data.studentCode == request.resource.data.username
        && request.auth.token.email == request.resource.data.email
        && request.auth.token.email == request.resource.data.studentCode + '@hthtv1.firebaseapp.com'
        && exists(studentRosterPath(schoolId, request.resource.data.studentCode))
        && get(studentRosterPath(schoolId, request.resource.data.studentCode)).data.status == 'active'
        && get(studentRosterPath(schoolId, request.resource.data.studentCode)).data.userId == request.resource.data.userId
        && get(studentRosterPath(schoolId, request.resource.data.studentCode)).data.displayName == request.resource.data.displayName
        && get(studentRosterPath(schoolId, request.resource.data.studentCode)).data.classId == request.resource.data.classId
        && sameGradeValue(get(studentRosterPath(schoolId, request.resource.data.studentCode)).data.grade, request.resource.data.grade);
    }

    function validOwnMemberUpdate(schoolId, memberId) {
      return signedIn()
        && request.auth.uid == memberId
        && resource.data.schoolId == schoolId
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.adminPermission == resource.data.adminPermission
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);
    }

    function validOwnLegacyMemberRepair(schoolId, memberId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let classRepairOk = !changed.hasAny(['classId'])
        || (!resource.data.keys().hasAll(['classId'])
          && resource.data.keys().hasAll(['lop_id'])
          && request.resource.data.classId == resource.data.lop_id);
      let gradeRepairOk = !changed.hasAny(['grade'])
        || (!resource.data.keys().hasAll(['grade'])
          && resource.data.keys().hasAll(['khoi'])
          && sameGradeValue(request.resource.data.grade, resource.data.khoi));
      return signedIn()
        && request.auth.uid == memberId
        && resource.data.get('status', resource.data.get('trang_thai', '')) == 'active'
        && (!resource.data.keys().hasAll(['schoolId']) || resource.data.schoolId == schoolId)
        && (!resource.data.keys().hasAll(['authUid']) || resource.data.authUid == memberId)
        && request.resource.data.schoolId == schoolId
        && request.resource.data.authUid == memberId
        && classRepairOk && gradeRepairOk
        && changed.hasOnly(['schoolId', 'authUid', 'classId', 'grade', 'updatedAt']);
    }

    function learningProgressModerationGrade(schoolId, data) {
      let progressGrade = data.get('khoi', '');
      let lessonId = data.get('lesson_id', '');
      let lessonPath = /databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId);
      return progressGrade != ''
        ? progressGrade
        : (lessonId is string && lessonId != '' && exists(lessonPath)
          ? get(lessonPath).data.get('khoi', '')
          : '');
    }

    function canModerateLearningResult(schoolId, data) {
      let grade = learningProgressModerationGrade(schoolId, data);
      return isAdmin(schoolId)
        || (isTeacher(schoolId) && grade != '' && teacherManagesGrade(schoolId, grade));
    }

    function validRetakePendingScoreState(oldData, newData) {
      let oldScore = oldData.get('assessment_score', -1);
      return oldScore is number && oldScore >= 0 && oldScore <= 10
        && (oldData.get('score_status', '') == 'finalized' || oldData.get('status', '') == 'completed')
        && newData.get('score_status', '') == 'retake_pending'
        && newData.get('score_reason', '') == 'official_retake_pending'
        && newData.get('previous_official_score', -1) == oldScore
        && !newData.keys().hasAny(['assessment_score', 'current_score', 'final_quiz_score']);
    }

    function validLearningResultModerationUpdate(schoolId) {
      let oldData = resource.data;
      let newData = request.resource.data;
      let changed = newData.diff(oldData).affectedKeys();
      let oldUserId = oldData.get('user_id', '');
      let oldLessonId = oldData.get('lesson_id', '');
      let oldVersion = oldData.get('result_version', 0) is number ? oldData.get('result_version', 0) : 0;
      let grantId = newData.get('official_retake_grant_id', '');
      let allowRetake = newData.get('result_state', oldData.get('result_state', 'valid')) == 'valid'
        && newData.get('retake_allowed', false) == true
        && newData.get('official_retake_remaining', 0) == 1
        && grantId is string && grantId != ''
        && newData.get('official_retake_granted_by_uid', '') == request.auth.uid
        && validRetakePendingScoreState(oldData, newData);
      let invalidateCheating = newData.get('result_state', '') == 'invalid_cheating'
        && newData.get('retake_allowed', true) == false
        && newData.get('official_retake_remaining', 1) == 0
        && newData.get('invalidated_reason', '') is string
        && newData.get('invalidated_reason', '') != ''
        && newData.get('invalidated_by_uid', '') == request.auth.uid;
      return (oldData.get('schoolId', schoolId) == schoolId || oldData.get('schoolId', '') == '' || oldData.get('schoolId', null) == null)
        && oldUserId is string && oldUserId != ''
        && oldLessonId is string && oldLessonId != ''
        && newData.get('schoolId', oldData.get('schoolId', schoolId)) == oldData.get('schoolId', schoolId)
        && newData.get('ownerUid', oldData.get('ownerUid', '')) == oldData.get('ownerUid', '')
        && newData.get('user_id', '') == oldUserId
        && newData.get('lesson_id', '') == oldLessonId
        && newData.get('result_version', oldVersion) is number
        && newData.get('result_version', oldVersion) >= oldVersion
        && changed.hasOnly([
          'result_state', 'retake_allowed', 'invalidated_reason', 'invalidated_at',
          'invalidated_by_uid', 'invalidated_by_name', 'last_result_action_id',
          'result_version', 'updated_at', 'updatedAt',
          'official_retake_remaining', 'official_retake_grant_id',
          'official_retake_granted_at', 'official_retake_granted_by_uid',
          'official_retake_granted_by_name',
          'previous_official_score', 'previous_official_completed_at',
          'score_status', 'score_reason', 'assessment_score', 'current_score', 'final_quiz_score'
        ])
        && (allowRetake || invalidateCheating);
    }

    function canCreateLearningResultAction(schoolId) {
      let data = request.resource.data;
      let lessonId = data.get('lesson_id', '');
      let lessonPath = /databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId);
      let actionGrade = data.get('khoi', '');
      let resolvedGrade = actionGrade != ''
        ? actionGrade
        : (lessonId is string && lessonId != '' && exists(lessonPath)
          ? get(lessonPath).data.get('khoi', '')
          : '');
      return (isAdmin(schoolId)
          || (isTeacher(schoolId) && resolvedGrade != '' && teacherManagesGrade(schoolId, resolvedGrade)))
        && data.schoolId == schoolId
        && data.schemaVersion == 1
        && data.actorUid == request.auth.uid
        && data.action_id is string && data.action_id != ''
        && data.action in ['allow_retake', 'invalidate_cheating']
        && data.lesson_id is string && data.lesson_id != ''
        && data.affected_user_ids is list
        && data.affected_progress_ids is list;
    }

    function consentPath(schoolId, sessionId, uid) {
      return /databases/$(database)/documents/schools/$(schoolId)/coLearningConsents/$(sessionId + '_' + uid);
    }

    function validConsent(schoolId, consentId) {
      let data = request.resource.data;
      let host = get(/databases/$(database)/documents/schools/$(schoolId)/members/$(data.hostUid)).data;
      let preparationStatus = data.get('preparationStatus', 'not_started');
      let preparationScore = data.get('preparationScore', 0);
      let preparationPercent = data.get('preparationWatchPercent', 0);
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && data.keys().hasOnly(['schoolId', 'schemaVersion', 'sessionId', 'lessonId', 'hostUid', 'ownerUid', 'userId', 'classId', 'grade', 'approved', 'preparationStatus', 'preparationScore', 'preparationWatchPercent', 'createdAt'])
        && data.schoolId == schoolId && data.schemaVersion == 1
        && data.ownerUid == request.auth.uid && data.userId == memberData(schoolId).userId
        && consentId == data.sessionId + '_' + request.auth.uid
        && data.classId == memberClassValue(schoolId) && sameGradeValue(data.grade, memberGradeValue(schoolId))
        && host.get('role', host.get('vai_tro', '')) == 'student' && activeProfile(schoolId, host)
        && host.get('classId', host.get('lop_id', '')) == data.classId
        && sameGradeValue(host.get('grade', host.get('khoi', '')), data.grade)
        && data.approved == true && data.createdAt == request.time
        && preparationStatus in ['not_started', 'in_progress', 'prepared', 'late_completed']
        && preparationScore is number && preparationScore >= 0 && preparationScore <= 10
        && ((preparationStatus == 'prepared' && preparationScore == 10)
          || (preparationStatus != 'prepared' && preparationScore == 0))
        && preparationPercent is number && preparationPercent >= 0 && preparationPercent <= 100
        && canReadLessonData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lessonId)).data);
    }

    function sessionConsentAt(schoolId, data, index) {
      let uid = data.participant_uids[index];
      let consent = get(consentPath(schoolId, data.session_id, uid)).data;
      return consent.ownerUid == uid && consent.userId == data.participant_user_ids[index]
        && data.participant_keys[index] == uid + '::' + consent.userId
        && consent.hostUid == request.auth.uid && consent.lessonId == data.lesson_id
        && consent.classId == data.lop_id && sameGradeValue(consent.grade, data.khoi)
        && consent.approved == true && consent.createdAt > request.time - duration.value(15, 'm');
    }

    function inheritedParticipantAllowed(schoolId, data, index) {
      let oldId = data.get('supersedes_session_id', '');
      let uid = data.participant_uids[index];
      let key = data.participant_keys[index];
      return data.schemaVersion in [4, 5]
        && oldId is string && oldId != ''
        && exists(/databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId))
        && get(/databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId)).data.lesson_id == data.lesson_id
        && get(/databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId)).data.lop_id == data.lop_id
        && sameGradeValue(get(/databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId)).data.khoi, data.khoi)
        && get(/databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId)).data.participant_uids.hasAny([request.auth.uid])
        && get(/databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId)).data.participant_uids.hasAny([uid])
        && get(/databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId)).data.participant_keys.hasAny([key]);
    }

    function groupParticipantAuthorizedAt(schoolId, data, index) {
      let uid = data.participant_uids[index];
      return (uid == request.auth.uid && data.participant_user_ids[index] == memberData(schoolId).userId)
        || inheritedParticipantAllowed(schoolId, data, index)
        || sessionConsentAt(schoolId, data, index);
    }

    function currentConsentPreparationMatches(schoolId, data, index) {
      let uid = data.participant_uids[index];
      let path = consentPath(schoolId, data.session_id, uid);
      return exists(path)
        && get(path).data.approved == true
        && get(path).data.preparationStatus == data.participant_preparation_statuses[index]
        && get(path).data.preparationScore == data.participant_preparation_scores[index]
        && get(path).data.preparationWatchPercent == data.participant_preparation_watch_percents[index];
    }

    function inheritedPreparationMatches(schoolId, data, index) {
      let oldId = data.get('supersedes_session_id', '');
      let oldPath = /databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId);
      let uid = data.participant_uids[index];
      return oldId is string && oldId != '' && exists(oldPath)
        && get(oldPath).data.participant_uids.hasAny([uid])
        && ((get(oldPath).data.schemaVersion == 5
            && get(oldPath).data.participant_preparation_statuses is list
            && get(oldPath).data.participant_preparation_scores is list
            && get(oldPath).data.participant_preparation_watch_percents is list
            && ((get(oldPath).data.group_size > 0 && get(oldPath).data.participant_uids[0] == uid
                && data.participant_preparation_statuses[index] == get(oldPath).data.participant_preparation_statuses[0]
                && data.participant_preparation_scores[index] == get(oldPath).data.participant_preparation_scores[0]
                && data.participant_preparation_watch_percents[index] == get(oldPath).data.participant_preparation_watch_percents[0])
              || (get(oldPath).data.group_size > 1 && get(oldPath).data.participant_uids[1] == uid
                && data.participant_preparation_statuses[index] == get(oldPath).data.participant_preparation_statuses[1]
                && data.participant_preparation_scores[index] == get(oldPath).data.participant_preparation_scores[1]
                && data.participant_preparation_watch_percents[index] == get(oldPath).data.participant_preparation_watch_percents[1])
              || (get(oldPath).data.group_size > 2 && get(oldPath).data.participant_uids[2] == uid
                && data.participant_preparation_statuses[index] == get(oldPath).data.participant_preparation_statuses[2]
                && data.participant_preparation_scores[index] == get(oldPath).data.participant_preparation_scores[2]
                && data.participant_preparation_watch_percents[index] == get(oldPath).data.participant_preparation_watch_percents[2])
              || (get(oldPath).data.group_size > 3 && get(oldPath).data.participant_uids[3] == uid
                && data.participant_preparation_statuses[index] == get(oldPath).data.participant_preparation_statuses[3]
                && data.participant_preparation_scores[index] == get(oldPath).data.participant_preparation_scores[3]
                && data.participant_preparation_watch_percents[index] == get(oldPath).data.participant_preparation_watch_percents[3])
              || (get(oldPath).data.group_size > 4 && get(oldPath).data.participant_uids[4] == uid
                && data.participant_preparation_statuses[index] == get(oldPath).data.participant_preparation_statuses[4]
                && data.participant_preparation_scores[index] == get(oldPath).data.participant_preparation_scores[4]
                && data.participant_preparation_watch_percents[index] == get(oldPath).data.participant_preparation_watch_percents[4])
              || (get(oldPath).data.group_size > 5 && get(oldPath).data.participant_uids[5] == uid
                && data.participant_preparation_statuses[index] == get(oldPath).data.participant_preparation_statuses[5]
                && data.participant_preparation_scores[index] == get(oldPath).data.participant_preparation_scores[5]
                && data.participant_preparation_watch_percents[index] == get(oldPath).data.participant_preparation_watch_percents[5])))
          || (get(oldPath).data.schemaVersion in [3, 4]
            && data.participant_preparation_statuses[index] == 'unknown'
            && data.participant_preparation_scores[index] == 10
            && data.participant_preparation_watch_percents[index] == 0));
    }

    function groupPreparationAuthorizedAt(schoolId, data, index) {
      return currentConsentPreparationMatches(schoolId, data, index)
        || inheritedPreparationMatches(schoolId, data, index);
    }

    function validGroupCreate(schoolId, sessionId) {
      let data = request.resource.data;
      return isActiveMember(schoolId) && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && data.schoolId == schoolId && data.schemaVersion in [3, 4, 5]
        && data.session_id == sessionId && data.ownerUid == request.auth.uid
        && data.host_uid == request.auth.uid && data.host_user_id == memberData(schoolId).userId
        && data.status == 'active' && data.study_mode == 'co_learning'
        && data.participant_uids is list && data.participant_user_ids is list && data.participant_keys is list
        && data.group_size is int && data.group_size >= 2 && data.group_size <= 6
        && data.participant_uids.size() == data.group_size
        && data.participant_user_ids.size() == data.group_size
        && data.participant_keys.size() == data.group_size
        && (data.schemaVersion != 5 || (
          data.participant_preparation_statuses is list
          && data.participant_preparation_scores is list
          && data.participant_preparation_watch_percents is list
          && data.participant_preparation_statuses.size() == data.group_size
          && data.participant_preparation_scores.size() == data.group_size
          && data.participant_preparation_watch_percents.size() == data.group_size
          && data.preparation_snapshot_at is string
        ))
        && data.participant_uids.toSet().size() == data.group_size
        && data.participant_user_ids.toSet().size() == data.group_size
        && data.participant_uids[0] == request.auth.uid
        && data.participant_user_ids[0] == memberData(schoolId).userId
        && data.participant_keys[0] == request.auth.uid + '::' + memberData(schoolId).userId
        && data.lop_id == memberClassValue(schoolId) && sameGradeValue(data.khoi, memberGradeValue(schoolId))
        && groupParticipantAuthorizedAt(schoolId, data, 0)
        && groupParticipantAuthorizedAt(schoolId, data, 1)
        && (data.group_size < 3 || groupParticipantAuthorizedAt(schoolId, data, 2))
        && (data.group_size < 4 || groupParticipantAuthorizedAt(schoolId, data, 3))
        && (data.group_size < 5 || groupParticipantAuthorizedAt(schoolId, data, 4))
        && (data.group_size < 6 || groupParticipantAuthorizedAt(schoolId, data, 5))
        && (data.schemaVersion != 5 || groupPreparationAuthorizedAt(schoolId, data, 0))
        && (data.schemaVersion != 5 || groupPreparationAuthorizedAt(schoolId, data, 1))
        && (data.schemaVersion != 5 || data.group_size < 3 || groupPreparationAuthorizedAt(schoolId, data, 2))
        && (data.schemaVersion != 5 || data.group_size < 4 || groupPreparationAuthorizedAt(schoolId, data, 3))
        && (data.schemaVersion != 5 || data.group_size < 5 || groupPreparationAuthorizedAt(schoolId, data, 4))
        && (data.schemaVersion != 5 || data.group_size < 6 || groupPreparationAuthorizedAt(schoolId, data, 5));
    }

    function groupProgressParticipantAuthorized(schoolId, group, uid, userId) {
      let currentConsent = consentPath(schoolId, group.session_id, uid);
      let oldId = group.get('supersedes_session_id', '');
      let oldPath = /databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(oldId);
      return (exists(currentConsent)
          && get(currentConsent).data.approved == true
          && get(currentConsent).data.ownerUid == uid
          && get(currentConsent).data.userId == userId
          && get(currentConsent).data.lessonId == group.lesson_id)
        || (group.schemaVersion in [4, 5]
          && oldId is string && oldId != ''
          && exists(oldPath)
          && get(oldPath).data.lesson_id == group.lesson_id
          && get(oldPath).data.lop_id == group.lop_id
          && sameGradeValue(get(oldPath).data.khoi, group.khoi)
          && get(oldPath).data.participant_uids.hasAny([group.host_uid])
          && get(oldPath).data.participant_uids.hasAny([uid])
          && get(oldPath).data.participant_keys.hasAny([uid + '::' + userId]));
    }

    function validGroupProgress(schoolId, data) {
      let group = get(/databases/$(database)/documents/schools/$(schoolId)/coLearningSessions/$(data.co_learning_session_id)).data;
      let target = get(/databases/$(database)/documents/schools/$(schoolId)/members/$(data.ownerUid)).data;
      return data.study_mode == 'co_learning' && group.schemaVersion in [3, 4, 5]
        && group.status in ['active', 'completed', 'cancelled_retake']
        && group.participant_uids.hasAny([request.auth.uid])
        && group.participant_keys.hasAny([data.ownerUid + '::' + data.user_id])
        && group.lesson_id == data.lesson_id && data.result_group_id == group.session_id
        && data.lop_id == group.lop_id && sameGradeValue(data.khoi, group.khoi)
        && target.get('role', target.get('vai_tro', '')) == 'student' && activeProfile(schoolId, target)
        && target.get('classId', target.get('lop_id', '')) == group.lop_id
        && sameGradeValue(target.get('grade', target.get('khoi', '')), group.khoi)
        && memberClassValue(schoolId) == group.lop_id && sameGradeValue(memberGradeValue(schoolId), group.khoi)
        && groupProgressParticipantAuthorized(schoolId, group, request.auth.uid, memberData(schoolId).userId)
        && groupProgressParticipantAuthorized(schoolId, group, data.ownerUid, data.user_id)
        && groupProgressPreparationMatches(group, data);
    }

    function lessonPreparationScoringEnabled(schoolId, lessonId) {
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data;
      let hasVideo = (lesson.get('intro_video_url', '') is string && lesson.get('intro_video_url', '') != '')
        || (lesson.get('intro_video_embed_url', '') is string && lesson.get('intro_video_embed_url', '') != '');
      return hasVideo
        && lesson.get('pre_lesson_enabled', true) != false
        && lesson.get('pre_lesson_score_enabled', true) != false;
    }

    function validProgressPreparationWeight(schoolId, data) {
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data;
      let weight = data.get('preparation_weight', 0);
      let scoreModel = data.get('score_model_version', 0);
      return !data.keys().hasAny(['preparation_weight'])
        || (scoreModel >= 3 && weight == 0)
        || (weight is number && weight >= 0 && weight <= 30
          && ((lessonPreparationScoringEnabled(schoolId, data.lesson_id)
              && weight == lesson.get('pre_lesson_score_weight', 10))
            || (!lessonPreparationScoringEnabled(schoolId, data.lesson_id) && weight == 0)));
    }

    function groupProgressPreparationMatches(group, data) {
      let status = data.get('pre_lesson_preparation_status', 'unknown');
      let score = data.get('preparation_score', 0);
      let scoreModel = data.get('score_model_version', 0);
      return scoreModel >= 3
        || !data.keys().hasAny(['preparation_weight'])
        || group.schemaVersion != 5
        || ((group.group_size > 0 && group.participant_uids[0] == data.ownerUid
              && status == group.participant_preparation_statuses[0]
              && score == group.participant_preparation_scores[0])
          || (group.group_size > 1 && group.participant_uids[1] == data.ownerUid
              && status == group.participant_preparation_statuses[1]
              && score == group.participant_preparation_scores[1])
          || (group.group_size > 2 && group.participant_uids[2] == data.ownerUid
              && status == group.participant_preparation_statuses[2]
              && score == group.participant_preparation_scores[2])
          || (group.group_size > 3 && group.participant_uids[3] == data.ownerUid
              && status == group.participant_preparation_statuses[3]
              && score == group.participant_preparation_scores[3])
          || (group.group_size > 4 && group.participant_uids[4] == data.ownerUid
              && status == group.participant_preparation_statuses[4]
              && score == group.participant_preparation_scores[4])
          || (group.group_size > 5 && group.participant_uids[5] == data.ownerUid
              && status == group.participant_preparation_statuses[5]
              && score == group.participant_preparation_scores[5]));
    }

    function progressNumberBetween(data, key, minValue, maxValue, defaultValue) {
      let value = data.get(key, defaultValue);
      return value is number && value >= minValue && value <= maxValue;
    }

    function validProgressNumericEnvelope(data) {
      let quizTotal = data.get('quiz_total', 0);
      let quizAnswered = data.get('quiz_answered', 0);
      let quizCorrect = data.get('quiz_correct', 0);
      let completedSteps = data.get('completed_steps', 0);
      let totalSteps = data.get('total_steps', 0);
      let preparationStatus = data.get('pre_lesson_preparation_status', 'not_started');
      let scoreModel = data.get('score_model_version', 0);
      let scoreStatus = data.get('score_status', 'in_progress');
      return data.status in ['not_started', 'in_progress', 'completed']
        && data.study_mode in ['single', 'co_learning']
        && progressNumberBetween(data, 'completion_percent', 0, 100, 0)
        && progressNumberBetween(data, 'quiz_percent', 0, 100, 0)
        && progressNumberBetween(data, 'assessment_score', 0, 10, 0)
        && progressNumberBetween(data, 'learning_process_score', 0, 10, 0)
        && progressNumberBetween(data, 'final_quiz_score', 0, 10, 0)
        && progressNumberBetween(data, 'current_score', 0, 10, 0)
        && progressNumberBetween(data, 'preparation_score', 0, 10, 0)
        && quizTotal is number && quizTotal >= 0
        && quizAnswered is number && quizAnswered >= 0 && quizAnswered <= quizTotal
        && quizCorrect is number && quizCorrect >= 0 && quizCorrect <= quizAnswered
        && completedSteps is number && completedSteps >= 0
        && totalSteps is number && totalSteps >= 0
        && completedSteps <= totalSteps
        && (!data.keys().hasAny(['pre_lesson_preparation_status'])
          || preparationStatus in ['not_started', 'in_progress', 'prepared', 'late_completed'])
        && (!data.keys().hasAny(['score_status'])
          || data.score_status in ['in_progress', 'finalized', 'not_applicable'])
        && (!data.keys().hasAny(['score_model_version'])
          || (data.score_model_version is int && data.score_model_version >= 1 && data.score_model_version <= 4))
        && (!data.keys().hasAny(['scored_section_count'])
          || (data.scored_section_count is int && data.scored_section_count >= 0))
        && (!data.keys().hasAny(['scorable_section_count'])
          || (data.scorable_section_count is int && data.scorable_section_count >= 0
            && data.get('scored_section_count', 0) <= data.scorable_section_count))

        && (scoreModel < 3
          || (data.get('preparation_score', 0) == 0
            && data.get('preparation_weight', 0) == 0
            && ((scoreStatus == 'finalized'
                && data.keys().hasAll(['assessment_score', 'current_score'])
                && data.assessment_score == data.current_score)
              || (scoreStatus != 'finalized'
                && !data.keys().hasAny(['assessment_score'])))))

        && (scoreModel != 4
          || (data.get('preparation_score', 0) == 0
            && data.get('preparation_weight', 0) == 0
            && data.get('learning_component_weight', 0) == 0
            && data.get('final_component_weight', 100) in [0, 100]
            && !data.keys().hasAny(['learning_process_score'])
            && ((scoreStatus == 'finalized'
                && data.keys().hasAll(['assessment_score', 'current_score', 'final_quiz_score'])
                && data.assessment_score == data.current_score
                && data.assessment_score == data.final_quiz_score
                && ((data.get('score_reason', '') == 'deadline_missed'
                    && data.assessment_score == 0
                    && data.current_score == 0
                    && data.final_quiz_score == 0)
                  || (data.get('step_details', {}).get('luyen_tap', {}).get('completed', false) == true
                    && data.get('step_details', {}).get('luyen_tap', {}).get('finalExam', {}).get('status', '') in ['submitted', 'auto_submitted', 'expired'])))
              || (scoreStatus != 'finalized'
                && !data.keys().hasAny(['assessment_score', 'current_score'])))));
    }

    function validProgressWrite(schoolId, progressId) {
      let data = request.resource.data;
      return isActiveMember(schoolId)
        && data.schoolId == schoolId && data.schemaVersion == 2
        && progressId == data.user_id + '_' + data.lesson_id
        && data.result_state == 'valid'
        && data.result_version is number && data.result_version >= 0
        && validProgressNumericEnvelope(data)
        && canReadLessonData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data)
        && lessonContentReadableStatus(get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data)
        && validProgressPreparationWeight(schoolId, data)
        && ((data.study_mode == 'co_learning' && validGroupProgress(schoolId, data))
          || (data.study_mode == 'single' && data.ownerUid == request.auth.uid
            && data.user_id == memberData(schoolId).userId));
    }

    function validScoreModelV4Submission(schoolId, progressId) {
      let data = request.resource.data;
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data;
      let finalExam = data.get('step_details', {}).get('luyen_tap', {}).get('finalExam', {});
      let score = data.get('final_quiz_score', -1);
      let total = finalExam.get('total_count', 0);
      let correct = finalExam.get('correct_count', 0);
      return isActiveMember(schoolId)
        && data.schoolId == schoolId && data.schemaVersion == 2
        && progressId == data.user_id + '_' + data.lesson_id
        && data.get('result_state', '') == 'valid'
        && data.get('result_version', -1) is number && data.get('result_version', -1) >= 0
        && data.get('score_model_version', 0) == 4
        && data.get('score_status', '') == 'finalized'
        && score is number && score >= 0 && score <= 10
        && data.get('current_score', -1) == score
        && data.get('assessment_score', -1) == score
        && data.get('preparation_score', 0) == 0
        && data.get('preparation_weight', 0) == 0
        && data.get('learning_component_weight', 0) == 0
        && data.get('final_component_weight', 100) == 100
        && finalExam.get('status', '') in ['submitted', 'auto_submitted', 'expired']
        && finalExam.get('score', -1) == score
        && total is number && total > 0
        && correct is number && correct >= 0 && correct <= total
        && data.get('step_details', {}).get('luyen_tap', {}).get('completed', false) == true
        && canReadLessonData(schoolId, lesson)
        && lessonContentReadableStatus(lesson)
        && validProgressPreparationWeight(schoolId, data)
        && ((data.study_mode == 'co_learning' && validGroupProgress(schoolId, data))
          || (data.study_mode == 'single'
            && data.ownerUid == request.auth.uid
            && data.user_id == memberData(schoolId).userId));
    }

    function isCurrentStudentCanonicalLearningProgressId(schoolId, progressId) {
      let userId = currentStudentUserId(schoolId);
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && userId != ''
        && progressId.matches(userId + '_.*');
    }

    function learningProgressBelongsToCurrentStudent(schoolId, progressId, data) {
      let userId = currentStudentUserId(schoolId);
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && userId != ''
        && data.get('user_id', '') == userId
        && data.get('lesson_id', '') is string
        && progressId == userId + '_' + data.get('lesson_id', '');
    }

    function validLegacyLearningProgressRepair(schoolId, progressId) {
      let oldData = resource.data;
      let newData = request.resource.data;
      return validProgressWrite(schoolId, progressId)
        && progressId == newData.user_id + '_' + newData.lesson_id
        && oldData.get('user_id', newData.user_id) == newData.user_id
        && oldData.get('lesson_id', newData.lesson_id) == newData.lesson_id
        && (!oldData.keys().hasAny(['result_version']) || newData.result_version >= oldData.result_version);
    }

    function resultCanResume() {
      return (!resource.data.keys().hasAny(['result_state']) || resource.data.result_state != 'invalid_cheating')
        && (!resource.data.keys().hasAny(['retake_allowed']) || resource.data.retake_allowed != false);
    }

    function validRetakeAttemptWrite(schoolId, progressId, attemptId) {
      let data = request.resource.data;
      let userId = currentStudentUserId(schoolId);
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data;
      let official = get(/databases/$(database)/documents/schools/$(schoolId)/learningProgress/$(progressId)).data;
      let referenceScore = data.get('reference_score', 0);
      let officialScore = data.get('official_score_snapshot', 0);
      return isActiveMember(schoolId)
        && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
        && userId != ''
        && data.schoolId == schoolId
        && data.schemaVersion == 1
        && data.attempt_id == attemptId
        && data.attempt_number is int && data.attempt_number > 0
        && data.lesson_id is string && data.lesson_id != ''
        && data.user_id == userId
        && data.ownerUid == request.auth.uid
        && data.is_official is bool
        && data.get('retake_mode', 'reference') in ['reference', 'official_update']
        && progressId == userId + '_' + data.lesson_id
        && data.status in ['in_progress', 'completed']
        && data.completion_percent is number && data.completion_percent >= 0 && data.completion_percent <= 100
        && data.get('score_status', 'in_progress') in ['in_progress', 'finalized', 'not_applicable']
        && (!data.keys().hasAny(['reference_score']) || (referenceScore is number && referenceScore >= 0 && referenceScore <= 10))
        && (!data.keys().hasAny(['official_score_snapshot']) || (officialScore is number && officialScore >= 0 && officialScore <= 10))
        && data.get('score_model_version', 4) in [3, 4]
        && data.progress is map
        && official.get('user_id', '') == userId
        && official.get('lesson_id', '') == data.lesson_id
        && ((data.get('retake_mode', 'reference') == 'reference'
              && data.is_official == false
              && (official.get('score_status', '') == 'finalized'
                || (official.get('status', '') == 'completed' && official.keys().hasAny(['assessment_score'])))
              && lesson.get('allow_retake_after_completion', false) == true)
          || (data.get('retake_mode', '') == 'official_update'
              && data.is_official == true
              && official.get('official_retake_remaining', 0) > 0
              && official.get('official_retake_grant_id', '') != ''
              && data.get('official_retake_grant_id', '') == official.get('official_retake_grant_id', '')
              && ((official.get('score_status', '') == 'retake_pending'
                    && official.get('previous_official_score', -1) is number
                    && official.get('previous_official_score', -1) >= 0
                    && official.get('previous_official_score', -1) <= 10)
                || official.get('score_status', '') == 'finalized')))
        && canReadLessonData(schoolId, lesson)
        && (lessonContentReadableStatus(lesson) || canManageLearningContent(schoolId));
    }

    function canReadRetakeAttempt(schoolId, data) {
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data;
      return isActiveMember(schoolId)
        && (data.ownerUid == request.auth.uid
          || isAdmin(schoolId)
          || (isTeacher(schoolId) && canManageGradeData(schoolId, lesson)));
    }

    function validTeacherDeadlineZeroCreate(schoolId, progressId) {
      let data = request.resource.data;
      let lesson = get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(data.lesson_id)).data;
      let end = lesson.get('access_end_at', null);
      return isActiveMember(schoolId)
        && (isAdmin(schoolId) || (isTeacher(schoolId) && canManageGradeData(schoolId, lesson)))
        && data.schoolId == schoolId && data.schemaVersion == 2
        && progressId == data.user_id + '_' + data.lesson_id
        && data.get('score_model_version', 0) == 4
        && data.get('score_status', '') == 'finalized'
        && data.get('score_reason', '') == 'deadline_missed'
        && data.get('deadline_status', '') == 'missed'
        && data.get('assessment_score', -1) == 0
        && data.get('current_score', -1) == 0
        && data.get('final_quiz_score', -1) == 0
        && data.get('result_state', '') == 'valid'
        && !(lesson.get('cho_phep_nop_sau_han', false) in [true, 'true', 1, '1'])
        && (end is timestamp && request.time > end)
        && validProgressNumericEnvelope(data);
    }

    function validTeacherDeadlineZeroUpdate(schoolId, progressId) {
      return validTeacherDeadlineZeroCreate(schoolId, progressId)
        && request.resource.data.user_id == resource.data.get('user_id', request.resource.data.user_id)
        && request.resource.data.lesson_id == resource.data.get('lesson_id', request.resource.data.lesson_id);
    }

    function validRegistryLink(schoolId, lessonId) {
      let data = request.resource.data;
      let registry = getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessonNumberRegistry/$(data.lesson_key)).data;
      return registry.schoolId == schoolId && registry.grade == data.khoi
        && registry.lessonNumber == data.lesson_number
        && ((data.lop_id == '' && registry.allLessonId == lessonId)
          || (data.lop_id != '' && registry.allLessonId == '' && registry.classLessonIds[data.lop_id] == lessonId));
    }

    match /schools/{schoolId} {
      allow read: if isActiveMember(schoolId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if signedIn()
          && (request.auth.uid == memberId
            || isAdmin(schoolId)
            || (isActiveMember(schoolId) && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
              && resource.data.role == 'student'
              && resource.data.status == 'active'
              && resource.data.classId == memberClassValue(schoolId))
            || teacherManagesGrade(schoolId, resource.data.grade));
        allow create: if (isAdmin(schoolId)
            && validMemberCreate(schoolId, memberId))
          || validStudentRosterClaim(schoolId, memberId);
        allow update: if (isAdmin(schoolId) && validMemberCreate(schoolId, memberId))
          || validOwnMemberUpdate(schoolId, memberId)
          || validOwnLegacyMemberRepair(schoolId, memberId);
        allow delete: if isAdmin(schoolId)
          && request.auth.uid != memberId;
      }

      match /studentRoster/{studentCode} {
        allow get: if isAdmin(schoolId)
          || teacherManagesGrade(schoolId, resource.data.grade)
          || (isActiveMember(schoolId)
            && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
            && resource.data.role == 'student'
            && resource.data.status == 'active'
            && resource.data.classId == memberClassValue(schoolId)
            && sameGradeValue(resource.data.grade, memberGradeValue(schoolId)))
          || (signedIn() && request.auth.token.email == studentCode + '@hthtv1.firebaseapp.com');
        allow list: if isAdmin(schoolId)
          || teacherManagesGrade(schoolId, resource.data.grade)
          || (isActiveMember(schoolId)
            && memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
            && resource.data.role == 'student'
            && resource.data.status == 'active'
            && resource.data.classId == memberClassValue(schoolId)
            && sameGradeValue(resource.data.grade, memberGradeValue(schoolId)));
        allow create, update: if isAdmin(schoolId)
          && validStudentRosterDocument(schoolId, studentCode);
        allow delete: if isAdmin(schoolId);
      }

      match /academicYears/{academicYearId} {
        allow read: if isActiveMember(schoolId);
        allow create, update: if isAdmin(schoolId)
          && validCatalogDocument(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      match /classes/{classId} {
        allow read: if isActiveMember(schoolId);
        allow create, update: if isAdmin(schoolId)
          && validCatalogDocument(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      match /subjects/{subjectId} {
        allow read: if isActiveMember(schoolId);
        allow create, update: if isAdmin(schoolId)
          && validCatalogDocument(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      match /migrations/{migrationId} {
        allow read: if isActiveMember(schoolId);
        allow create, update: if isAdmin(schoolId)
          && validCatalogDocument(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      // V6.88.4: capability probe ổn định theo nghiệp vụ, không khóa frontend
      // vào một chuỗi số phiên bản Rules. Payload mới còn kiểm tra đúng khối mà
      // giáo viên đang quản lý. Nhánh legacy 6.88.3 được giữ để rollout an toàn.
      match /rulesProbes/{probeId} {
        allow get: if canManageLearningContent(schoolId)
          && request.auth.uid == probeId;
        allow list: if false;
        allow create, update: if canManageLearningContent(schoolId)
          && request.auth.uid == probeId
          && request.resource.data.keys().hasAll(['schoolId', 'ownerUid', 'purpose'])
          && request.resource.data.schoolId == schoolId
          && request.resource.data.ownerUid == request.auth.uid
          && ((request.resource.data.get('capability', '') == 'lesson_publish_v2'
                && request.resource.data.get('purpose', '') == 'lesson-publish-capability'
                && request.resource.data.get('schemaVersion', 0) == 1
                && canManageGradeData(schoolId, request.resource.data))
              || (request.resource.data.get('rulesVersion', '') == '6.88.3'
                && request.resource.data.get('purpose', '') == 'lesson-publish-probe'));
        allow delete: if isAdmin(schoolId) || (canManageLearningContent(schoolId)
          && request.auth.uid == probeId
          && resource.data.ownerUid == request.auth.uid
          && ((resource.data.get('capability', '') == 'lesson_publish_v2'
                && resource.data.get('purpose', '') == 'lesson-publish-capability')
              || resource.data.get('rulesVersion', '') == '6.88.3'));
      }

      match /lessons/{lessonId} {

        allow list: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || canReadTeacherOwnedOrShared(schoolId, resource.data)
            || (resource.data.pham_vi == 'shared'
              && resource.data.trang_thai == 'approved_shared'));

        allow get: if isAdmin(schoolId) || isTeacher(schoolId) || canReadLessonData(schoolId, resource.data);
        allow create: if canManageLearningContent(schoolId)
          && validLessonSecurityEnvelope(schoolId, lessonId)
          && validRegistryLink(schoolId, lessonId)
          && validArenaLessonMetadata()
          && validLessonAccessConfiguration();
        allow update: if canWriteOwnedContent(schoolId, resource.data)
          && validLessonUpdateSecurityEnvelope(schoolId, lessonId)
          && (!lessonIdentityFieldsChanged() || validRegistryLink(schoolId, lessonId))
          && validArenaLessonMetadata()
          && validLessonAccessConfiguration();
        allow delete: if canWriteOwnedContent(schoolId, resource.data)
          && canManageGradeData(schoolId, resource.data);

        match /preparationSubmissions/{submissionId} {
          allow get: if isActiveMember(schoolId)
            && ((memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
                && submissionId.matches(request.auth.uid + '_r[0-9]+'))
              || isAdmin(schoolId)
              || (isTeacher(schoolId)
                && canManageGradeData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data)));
          allow list: if isActiveMember(schoolId)
            && (isAdmin(schoolId)
              || (isTeacher(schoolId)
                && canManageGradeData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data)));
          allow create: if validPreparationSubmissionCreate(schoolId, lessonId, submissionId);
          allow update: if false;
          allow delete: if isAdmin(schoolId)
            || (isTeacher(schoolId)
              && canWriteOwnedContent(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data)
              && canManageGradeData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data));
        }

        match /content/{contentId} {
          allow read: if isAdmin(schoolId) || canReadLessonContent(
            schoolId,
            get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
          );

          allow create: if canWriteOwnedContent(
              schoolId,
              get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
            )
            && canManageGradeData(
              schoolId,
              get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
            )
            && request.resource.data.schoolId == schoolId
            && request.resource.data.schemaVersion == 2
            && request.resource.data.keys().hasAll(['lessonId'])
            && request.resource.data.lessonId == lessonId
            && (isAdmin(schoolId)
              || (isTeacher(schoolId)
                && request.resource.data.keys().hasAll(['ownerUid', 'createdByUid', 'khoi'])
                && request.resource.data.ownerUid == request.auth.uid
                && request.resource.data.createdByUid == request.auth.uid
                && request.resource.data.khoi is string
                && request.resource.data.khoi == get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data.khoi));

          allow update: if canWriteOwnedContent(
            schoolId,
            getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
          )
            && canManageGradeData(
              schoolId,
              getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
            )
            && request.resource.data.schoolId == schoolId
            && request.resource.data.schemaVersion == 2
            && (!request.resource.data.keys().hasAny(['lessonId']) || request.resource.data.lessonId == lessonId)
            && (!request.resource.data.keys().hasAny(['ownerUid']) || request.resource.data.ownerUid == getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data.createdByUid)
            && (!request.resource.data.keys().hasAny(['createdByUid']) || request.resource.data.createdByUid == getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data.createdByUid)
            && (!request.resource.data.keys().hasAny(['khoi']) || request.resource.data.khoi == getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data.khoi);

          allow delete: if isAdmin(schoolId)
            || (canWriteOwnedContent(
                schoolId,
                get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
              )
              && canManageGradeData(
                schoolId,
                get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
              ));
        }

        match /activities/{activityId} {

          allow get: if isAdmin(schoolId)
            || (canManageLearningContent(schoolId)
              && canReadLessonData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data)
              && canManageGradeData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data))
            || (lessonSelfStudyEnabled(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data)
              && canReadLessonContent(
                schoolId,
                get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
              ))
            || studentActivityReleased(
              schoolId,
              lessonId,
              activityId,
              get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
            );
          allow list: if isAdmin(schoolId)
            || (canManageLearningContent(schoolId)
              && canReadLessonData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data)
              && canManageGradeData(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data));

          allow create, update: if canWriteOwnedContent(
              schoolId,
              getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
            )
            && canManageGradeData(
              schoolId,
              getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
            )
            && request.resource.data.schoolId == schoolId
            && request.resource.data.schemaVersion == 3
            && request.resource.data.lessonId == lessonId
            && request.resource.data.activity_id == activityId
            && request.resource.data.ownerUid == getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data.createdByUid
            && request.resource.data.createdByUid == getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data.createdByUid
            && sameGradeValue(request.resource.data.khoi, getAfter(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data.khoi);

          allow delete: if isAdmin(schoolId)
            || (canWriteOwnedContent(
                schoolId,
                get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
              )
              && canManageGradeData(
                schoolId,
                get(/databases/$(database)/documents/schools/$(schoolId)/lessons/$(lessonId)).data
              ));
        }
      }

      match /lessonNumberRegistry/{registryId} {

        allow get: if isAdmin(schoolId) || isTeacher(schoolId);
        allow list: if isAdmin(schoolId)
          || (isTeacher(schoolId)
            && resource.data.keys().hasAll(['grade'])
            && teacherManagesGrade(schoolId, resource.data.grade));
        allow create, update: if (isAdmin(schoolId)
            || (isTeacher(schoolId)
              && request.resource.data.keys().hasAll(['grade'])
              && teacherManagesGrade(schoolId, request.resource.data.grade)))
          && request.resource.data.schoolId == schoolId
          && request.resource.data.schemaVersion == 2
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.lessonNumber is int
          && request.resource.data.lessonNumber > 0;
        allow delete: if isAdmin(schoolId)
          || (isTeacher(schoolId)
            && ((resource.data.keys().hasAll(['grade'])
                && teacherManagesGrade(schoolId, resource.data.grade))
              || (resource.data.keys().hasAll(['updatedByUid'])
                && resource.data.updatedByUid == request.auth.uid)));
      }

      match /lessonDeletionJobs/{jobId} {
        allow get: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || (isTeacher(schoolId) && resource.data.get('ownerUid', '') == request.auth.uid));
        allow list: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || (isTeacher(schoolId) && resource.data.get('ownerUid', '') == request.auth.uid));
        allow create, update: if isActiveMember(schoolId)
          && request.resource.data.get('schoolId', '') == schoolId
          && request.resource.data.get('lesson_id', '') == jobId
          && request.resource.data.get('schemaVersion', 0) in [1, 2]
          && (isAdmin(schoolId)
            || (isTeacher(schoolId)
              && request.resource.data.get('ownerUid', '') == request.auth.uid
              && request.resource.data.get('requestedByUid', '') == request.auth.uid));
        allow delete: if isAdmin(schoolId);
      }

      match /preLessonSubmissions/{submissionId} {
        // V6.86.0: canonical GET của học sinh phải hoạt động cả khi document chưa tồn tại.
        // Không tham chiếu resource.data ở nhánh học sinh, nếu không lần mở video đầu tiên
        // sẽ bị permission-denied thay vì trả về not-found.
        allow get: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || (isTeacher(schoolId) && canManageGradeData(schoolId, resource.data))
            || (memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
              && currentStudentUserId(schoolId) != ''
              && submissionId.matches(currentStudentUserId(schoolId) + '_.*')));
        allow list: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || (isTeacher(schoolId) && canManageGradeData(schoolId, resource.data))
            || (memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
              && resource.data.ownerUid == request.auth.uid));
        allow create, update: if false;
        allow delete: if isAdmin(schoolId)
          || (resource.data.keys().hasAll(['lesson_id'])
            && canDeleteLessonDependency(schoolId, resource.data.lesson_id));
      }

      match /preLessonProgress/{progressId} {

        allow get: if isActiveMember(schoolId)
          && (isCurrentStudentCanonicalPreLessonId(schoolId, progressId)
            || preLessonProgressBelongsToCurrentStudent(schoolId, resource.data)
            || isAdmin(schoolId)
            || (isTeacher(schoolId) && canManageGradeData(schoolId, resource.data)));
        allow list: if isActiveMember(schoolId)
          && (preLessonProgressBelongsToCurrentStudent(schoolId, resource.data)
            || isAdmin(schoolId)
            || (isTeacher(schoolId) && canManageGradeData(schoolId, resource.data)));
        allow create: if validPreLessonProgressWrite(schoolId, progressId)
          && validPreLessonCompletionCreate(schoolId);
        allow update: if (
            (resource.data.get('ownerUid', '') == request.auth.uid
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.user_id == resource.data.user_id
              && request.resource.data.lesson_id == resource.data.lesson_id
              && request.resource.data.watched_seconds >= resource.data.get('watched_seconds', 0)
              && request.resource.data.watch_percent >= resource.data.get('watch_percent', 0)
              && request.resource.data.get('playback_seconds', 0) >= resource.data.get('playback_seconds', 0))
            || validPreLessonLegacyMigration(schoolId, progressId)
          )
          && validPreLessonProgressWrite(schoolId, progressId)
          && validPreLessonCompletionUpdate(schoolId);
        allow delete: if isAdmin(schoolId)
          || (resource.data.keys().hasAll(['lesson_id'])
            && canDeleteLessonDependency(schoolId, resource.data.lesson_id));
      }

      match /teachingSessions/{sessionId} {
        allow read: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || (isTeacher(schoolId) && resource.data.keys().hasAll(['grade']) && teacherManagesGrade(schoolId, resource.data.grade))
            || (memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
              && resource.data.class_id == memberClassValue(schoolId)
              && sameGradeValue(resource.data.grade, memberGradeValue(schoolId))));
        allow create, update: if validTeachingSessionWrite(schoolId, sessionId);
        allow delete: if isAdmin(schoolId)
          || (resource.data.keys().hasAll(['lesson_id'])
            && canDeleteLessonDependency(schoolId, resource.data.lesson_id));
      }

      match /learningProgress/{progressId} {
        allow read: if isActiveMember(schoolId)
          && (isCurrentStudentCanonicalLearningProgressId(schoolId, progressId)
            || resource.data.get('ownerUid', '') == request.auth.uid
            || learningProgressBelongsToCurrentStudent(schoolId, progressId, resource.data)
            || isAdmin(schoolId)
            || (isTeacher(schoolId) && canManageGradeData(schoolId, resource.data)));
        allow create: if validProgressWrite(schoolId, progressId)
          || validScoreModelV4Submission(schoolId, progressId)
          || validTeacherDeadlineZeroCreate(schoolId, progressId);
        // V6.84.11: moderation phải được xét TRƯỚC luồng ghi tiến độ học sinh.
        // Luồng progress/score rất nặng và có nhiều get()/validator; nếu chạy trước
        // trong một moderation write, Rules có thể chạm giới hạn đánh giá trước khi
        // tới nhánh giáo viên/admin và trả permission-denied dù grant hợp lệ.
        allow update: if (canModerateLearningResult(schoolId, resource.data)
            && validLearningResultModerationUpdate(schoolId))
          || (isTeacher(schoolId) && canManageGradeData(schoolId, resource.data)
            && validTeacherDeadlineZeroUpdate(schoolId, progressId))
          || (isAdmin(schoolId) && validTeacherDeadlineZeroUpdate(schoolId, progressId))
          || (resultCanResume()
            && ((request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
                && request.resource.data.get('user_id', '') == resource.data.get('user_id', request.resource.data.get('user_id', ''))
                && request.resource.data.get('lesson_id', '') == resource.data.get('lesson_id', request.resource.data.get('lesson_id', ''))
                && (!resource.data.keys().hasAny(['result_version'])
                  || request.resource.data.get('result_version', resource.data.get('result_version', 0)) >= resource.data.get('result_version', 0))
                && (validProgressWrite(schoolId, progressId) || validScoreModelV4Submission(schoolId, progressId)))
              || validLegacyLearningProgressRepair(schoolId, progressId)));
        allow delete: if isAdmin(schoolId)
          || (resource.data.keys().hasAll(['lesson_id'])
            && canDeleteLessonDependency(schoolId, resource.data.lesson_id));

        match /retakes/{attemptId} {
          allow read: if canReadRetakeAttempt(schoolId, resource.data);
          allow create: if validRetakeAttemptWrite(schoolId, progressId, attemptId);
          allow update: if resource.data.ownerUid == request.auth.uid
            && resource.data.user_id == request.resource.data.user_id
            && resource.data.lesson_id == request.resource.data.lesson_id
            && resource.data.attempt_id == request.resource.data.attempt_id
            && resource.data.attempt_number == request.resource.data.attempt_number
            && validRetakeAttemptWrite(schoolId, progressId, attemptId);
          allow delete: if isAdmin(schoolId)
            || (resource.data.keys().hasAll(['lesson_id'])
              && canDeleteLessonDependency(schoolId, resource.data.lesson_id));
        }
      }

      match /learningResultActions/{actionId} {
        allow read: if isAdmin(schoolId)
          || (isTeacher(schoolId)
            && resource.data.keys().hasAll(['khoi'])
            && teacherManagesGrade(schoolId, resource.data.khoi));
        allow create: if canCreateLearningResultAction(schoolId);

        allow update: if false;
        allow delete: if isAdmin(schoolId) || (resource.data.keys().hasAll(['lesson_id'])
          && canDeleteLessonDependency(schoolId, resource.data.lesson_id));
      }

      match /lessonComments/{commentId} {
        allow read: if isActiveMember(schoolId);
        allow create: if isActiveMember(schoolId)
          && request.resource.data.schoolId == schoolId
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isAdmin(schoolId)
          || (isActiveMember(schoolId) && resource.data.ownerUid == request.auth.uid);
        allow delete: if isAdmin(schoolId)
          || (resource.data.keys().hasAll(['lesson_id'])
            && canDeleteLessonDependency(schoolId, resource.data.lesson_id));
      }

      match /reviewPractices/{reviewId} {
        allow list: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || canReadTeacherReview(schoolId, resource.data)
            || (resource.data.pham_vi == 'shared'
              && resource.data.trang_thai == 'active'));
        allow get: if isActiveMember(schoolId)
          && (canReadPublishedReview(schoolId, resource.data)
            || isAdmin(schoolId)
            || canReadTeacherReview(schoolId, resource.data));
        allow create: if canManageLearningContent(schoolId)
          && canManageGradeData(schoolId, request.resource.data)
          && request.resource.data.schoolId == schoolId
          && request.resource.data.schemaVersion == 2
          && request.resource.data.ownerUid == request.auth.uid;
        allow update, delete: if isAdmin(schoolId)
          || (isTeacher(schoolId)
            && resource.data.ownerUid == request.auth.uid
            && canManageGradeData(schoolId, resource.data));

        match /content/{contentId} {
          allow read: if isActiveMember(schoolId)
            && (canOpenPublishedReview(
                schoolId,
                get(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId)).data
              )
              || isAdmin(schoolId)
              || canReadTeacherReview(
                schoolId,
                get(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId)).data
              ));
          allow create, update: if canManageLearningContent(schoolId)
            && canManageGradeData(
              schoolId,
              getAfter(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId)).data
            )
            && request.resource.data.schoolId == schoolId
            && request.resource.data.schemaVersion == 2
            && (isAdmin(schoolId)
              || getAfter(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId)).data.ownerUid == request.auth.uid);
          allow delete: if isAdmin(schoolId)
            || (isTeacher(schoolId)
              && get(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId)).data.ownerUid == request.auth.uid
              && canManageGradeData(
                schoolId,
                get(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(reviewId)).data
              ));
        }
      }

      match /reviewAttempts/{attemptId} {
        allow read: if isActiveMember(schoolId)
          && (resource.data.ownerUid == request.auth.uid
            || (resource.data.get('participant_user_ids', []) is list
              && resource.data.get('participant_user_ids', []).hasAny([currentStudentUserId(schoolId)]))
            || isAdmin(schoolId)
            || (resource.data.keys().hasAll(['review_id'])
              && canManageReviewAttempt(schoolId, resource.data.review_id)));
        allow create: if canCreateReviewAttempt(schoolId);
        allow update: if false;
        allow delete: if isAdmin(schoolId)
          || (isTeacher(schoolId)
            && resource.data.keys().hasAll(['review_id'])
            && get(/databases/$(database)/documents/schools/$(schoolId)/reviewPractices/$(resource.data.review_id)).data.ownerUid == request.auth.uid
            && canManageReviewAttempt(schoolId, resource.data.review_id));
      }

      match /coLearningConsents/{consentId} {
        allow read: if isActiveMember(schoolId)
          && (resource.data.ownerUid == request.auth.uid || resource.data.hostUid == request.auth.uid || isAdmin(schoolId)
            || canDeleteLessonDependency(schoolId, resource.data.lessonId));
        allow create: if validConsent(schoolId, consentId);
        allow update: if false;
        allow delete: if isActiveMember(schoolId)
          && (resource.data.ownerUid == request.auth.uid || resource.data.hostUid == request.auth.uid || isAdmin(schoolId)
            || canDeleteLessonDependency(schoolId, resource.data.lessonId));
      }

      match /coLearningSessions/{sessionId} {
        allow read: if isActiveMember(schoolId)
          && (isAdmin(schoolId) || canManageGradeData(schoolId, resource.data)
            || resource.data.participant_uids.hasAny([request.auth.uid])
            || canDeleteLessonDependency(schoolId, resource.data.lesson_id));
        allow create: if validGroupCreate(schoolId, sessionId);
        allow update: if isActiveMember(schoolId)
          && (((resource.data.schemaVersion in [3, 4, 5])
              && resource.data.status in ['active', 'completed', 'cancelled_retake']
              && resource.data.participant_uids.hasAny([request.auth.uid])
              && request.resource.data.status in ['active', 'completed']
              && request.resource.data.last_active_by_uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'result_group_id', 'result_version', 'assessment_score', 'completion_percent',
                'last_active_by_uid', 'last_active_at', 'participant_assessment_scores', 'updatedAt']))
            || ((resource.data.schemaVersion in [3, 4, 5])
              && resource.data.status in ['active', 'completed', 'cancelled_retake']
              && resource.data.participant_uids.hasAny([request.auth.uid])
              && request.resource.data.status == 'superseded'
              && request.resource.data.superseded_by_session_id is string
              && request.resource.data.superseded_by_session_id != ''
              && request.resource.data.membership_updated_by_uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'superseded_by_session_id', 'membership_updated_at', 'membership_updated_by_uid', 'updatedAt']))
            || (canManageGradeData(schoolId, resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'last_result_action_id', 'invalidated_at', 'invalidated_by_uid', 'updatedAt'])));
        allow delete: if isAdmin(schoolId)
          || (resource.data.keys().hasAll(['lesson_id'])
            && canDeleteLessonDependency(schoolId, resource.data.lesson_id));
      }

      match /accountDeletionJobs/{jobId} {
        allow read: if isAdmin(schoolId);

        allow create, update: if isAdmin(schoolId)
          && request.resource.data.schoolId == schoolId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.target is map
          && request.resource.data.target.userId == jobId
          && request.resource.data.target.uid != request.auth.uid
          && request.resource.data.lessonIds is list
          && request.resource.data.reviewIds is list
          && request.resource.data.status in ['deleting', 'retryable']
          && request.resource.data.identityStatus in ['', 'deleted_with_credentials', 'confirmed_in_console']
          && request.resource.data.keys().hasOnly(['schoolId', 'schemaVersion', 'target', 'lessonIds', 'reviewIds', 'status', 'identityStatus', 'updated_at', 'lastError']);
        allow delete: if isAdmin(schoolId);
      }

      match /scoreTrackingConfigs/{configId} {

        allow get: if isAdmin(schoolId) || isTeacher(schoolId);
        allow list: if isAdmin(schoolId);
        allow create: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || (isTeacher(schoolId)
              && request.resource.data.keys().hasAll(['grade'])
              && teacherManagesGrade(schoolId, request.resource.data.grade)))
          && request.resource.data.schoolId == schoolId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.academic_year is string
          && request.resource.data.academic_year != ''
          && request.resource.data.subject_id is string
          && request.resource.data.subject_id != ''
          && request.resource.data.grade is string
          && request.resource.data.grade != ''
          && request.resource.data.class_id is string
          && request.resource.data.midterm1_lesson_ids is list
          && request.resource.data.finalterm1_lesson_ids is list
          && request.resource.data.midterm2_lesson_ids is list
          && request.resource.data.finalterm2_lesson_ids is list
          && request.resource.data.annual_lesson_ids is list
          && request.resource.data.midterm1_lesson_ids.size() <= 100
          && request.resource.data.finalterm1_lesson_ids.size() <= 100
          && request.resource.data.midterm2_lesson_ids.size() <= 100
          && request.resource.data.finalterm2_lesson_ids.size() <= 100
          && request.resource.data.annual_lesson_ids.size() <= 100
          && request.resource.data.annual_mode in ['auto', 'manual'];
        allow update: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || (isTeacher(schoolId)
              && resource.data.keys().hasAll(['grade'])
              && request.resource.data.keys().hasAll(['grade'])
              && request.resource.data.grade == resource.data.grade
              && teacherManagesGrade(schoolId, resource.data.grade)))
          && request.resource.data.schoolId == schoolId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.academic_year is string
          && request.resource.data.academic_year != ''
          && request.resource.data.subject_id is string
          && request.resource.data.subject_id != ''
          && request.resource.data.grade is string
          && request.resource.data.grade != ''
          && request.resource.data.class_id is string
          && request.resource.data.midterm1_lesson_ids is list
          && request.resource.data.finalterm1_lesson_ids is list
          && request.resource.data.midterm2_lesson_ids is list
          && request.resource.data.finalterm2_lesson_ids is list
          && request.resource.data.annual_lesson_ids is list
          && request.resource.data.midterm1_lesson_ids.size() <= 100
          && request.resource.data.finalterm1_lesson_ids.size() <= 100
          && request.resource.data.midterm2_lesson_ids.size() <= 100
          && request.resource.data.finalterm2_lesson_ids.size() <= 100
          && request.resource.data.annual_lesson_ids.size() <= 100
          && request.resource.data.annual_mode in ['auto', 'manual'];
        allow delete: if isAdmin(schoolId)
          || (isTeacher(schoolId)
            && resource.data.keys().hasAll(['grade'])
            && teacherManagesGrade(schoolId, resource.data.grade));
      }

      match /appConfig/{configId} {
        allow read: if isActiveMember(schoolId);
        allow create, update, delete: if isAdmin(schoolId);
      }

      match /archivedGradeRecords/{recordId} {
        allow get, list: if isActiveMember(schoolId)
          && (isAdmin(schoolId)
            || (isTeacher(schoolId)
              && resource.data.keys().hasAll(['grade'])
              && teacherManagesGrade(schoolId, resource.data.grade))
            || (memberData(schoolId).get('role', memberData(schoolId).get('vai_tro', 'student')) == 'student'
              && resource.data.get('ownerUid', '') == request.auth.uid));
        allow create, update: if isAdmin(schoolId)
          && request.resource.data.get('schoolId', '') == schoolId;
        allow delete: if isAdmin(schoolId);
      }

      match /userAIConfigs/{memberId} {
        allow read: if isActiveMember(schoolId)
          && request.auth.uid == memberId;
        allow create, update: if false;
        allow delete: if isActiveMember(schoolId)
          && (request.auth.uid == memberId
            || (isAdmin(schoolId) && request.auth.uid != memberId));
      }


      match /userAISecrets/{memberId} {
        allow get: if isActiveMember(schoolId)
          && request.auth.uid == memberId;
        allow list: if false;
        allow create, update: if validUserAISecretWrite(schoolId, memberId);
        allow delete: if isActiveMember(schoolId)
          && request.auth.uid == memberId
          && resource.data.ownerUid == request.auth.uid;
      }

      match /slidesPrompts/{promptId} {
        allow read: if isActiveMember(schoolId)
          && (resource.data.ownerUid == request.auth.uid || isAdmin(schoolId));
        allow create: if canManageLearningContent(schoolId)
          && request.resource.data.schoolId == schoolId
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isAdmin(schoolId)
          || (isTeacher(schoolId) && resource.data.ownerUid == request.auth.uid);
        allow delete: if isAdmin(schoolId)
          || (isTeacher(schoolId) && resource.data.ownerUid == request.auth.uid)
          || (resource.data.keys().hasAll(['lesson_id'])
            && canDeleteLessonDependency(schoolId, resource.data.lesson_id));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
